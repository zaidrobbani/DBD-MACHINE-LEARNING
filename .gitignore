# --- MLOps: data & model artifacts (keep folder structure, ignore contents) ---
# data/raw/ TIDAK di-ignore di sini: isinya dilacak DVC, dan `dvc add` menulis
# data/raw/.gitignore sendiri. Kalau di-ignore di sini, DVC ikut melewatkan
# file .dvc di folder itu (dvc status: "no data tracked").
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

models/*
!models/.gitkeep
# Metrik di-commit ke git (dvc.yaml: cache: false) supaya `dvc metrics diff` bisa membandingkan antar commit.
!models/metrics.json

data/validation/*
!data/validation/.gitkeep

# --- Experiment tracking / logs ---
mlruns/
*.log

# --- Secrets ---
.env.local
secrets.yaml
